{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeniba-local-shadow",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run generate" },
  "vars": { "APP_MODE": "mock" },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountCoordinator"] }],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "zeniba-local-synthetic-evidence" }],
  "observability": { "enabled": false }
}
